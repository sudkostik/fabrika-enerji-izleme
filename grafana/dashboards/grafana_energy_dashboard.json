          "datasource": {
            "type": "mssql",
            "uid": "bfs2y0169i2v4b"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH Tuketim AS (\n    SELECT\n        [DateTime],\n        [Name],\n        [Index]\n        - LAG([Index]) OVER (\n            PARTITION BY [Name]\n            ORDER BY [DateTime]\n        ) AS SaatlikTuketim\n    FROM dbo.SayacVerileri\n    WHERE [Type] = 'Out'\n)\nSELECT\n    CAST([DateTime] AS DATE) AS Gun,\n    DATEPART(HOUR, [DateTime]) AS Saat,\n    SUM(SaatlikTuketim) AS kWh\nFROM Tuketim\nWHERE SaatlikTuketim IS NOT NULL\n  AND $__timeFilter([DateTime])\nGROUP BY\n    CAST([DateTime] AS DATE),\n    DATEPART(HOUR, [DateTime])\nORDER BY Gun, Saat;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Heatmap",
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "Saat",
            "rowField": "Gun",
            "valueField": "kWh"
          }
        }
      ],
      "type": "heatmap"
    }
